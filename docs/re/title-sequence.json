    "unit": "BIOS tick",
    "hz": 18.2065,
    "mark_ea": "0x11022",
    "wait_ea": "0x11039",
    "rule": "sub_11022 記錄目前 int 1Ah 的 tick，sub_11039(n) 忙等到 tick >= 記錄值 + n。因此所有等待都是精確的 tick 數，可靜態讀出。"
  },
  "memory_flag": {
    "global": "byte_1423A",
    "set_ea": "0x101a4",
